TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Leave empty at first: the bot replies to anyone with their user ID only, then add yours here
ALLOWED_USER_IDS=USER_ID_1,USER_ID_2

# --- Option A: DeepSeek API (default) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
# MODEL=deepseek-chat

# --- Option B: OpenRouter (DeepSeek and many other models) ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-openrouter-api-key
# MODEL=deepseek/deepseek-v4.1-flash

# --- Option C: local Ollama ---
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# MODEL=qwen3.5-chat:4b
# MODELS=qwen3.5-chat:4b,qwen3.5-chat:9b
# REASONING_EFFORT=none
# TEMPERATURE=0.7

# --- Optional ---
# WEB_SEARCH=on
# CONTEXT_TOKENS=16384
# TIMEZONE=America/Los_Angeles
# SOUL_FILE=soul.md
# USER_FILE=user.md
# LOCALE_FILE=locale.json
# SYSTEM_PROMPT=You are a helpful assistant
# CODE_MODEL=
# MAX_TOKENS=2048
# REQUEST_TIMEOUT=300
# DATA_DIR=data
